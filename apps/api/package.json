{
  "name": "@paypilot/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "test": "NODE_ENV=test tsx --test \"src/**/*.test.ts\"",
    "test:integration": "NODE_ENV=test RUN_DB_INTEGRATION=1 tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2",
    "jose": "5.9.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
