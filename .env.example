# ==============================================================================
# PayPilot HRMS & Payroll SaaS - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND REPLACE EVERY change-me VALUE.
# DO NOT COMMIT .env OR ANY ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Compose Infrastructure
# ------------------------------------------------------------------------------
# Port 5433 is used by default to avoid colliding with a local PostgreSQL on 5432.
POSTGRES_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
PAYPILOT_DB_NAME=paypilot
PAYPILOT_MIGRATOR_USER=paypilot_migrator
PAYPILOT_MIGRATOR_PASSWORD=change-me-migrator
PAYPILOT_APP_USER=paypilot_app
PAYPILOT_APP_PASSWORD=change-me-app

# Keycloak uses a separate database and credentials inside the same PostgreSQL
# container. It never shares PayPilot's application database.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Runtime connection: least-privileged paypilot_app role (no BYPASSRLS).
# Prisma Client uses this URL.
DATABASE_URL="postgresql://paypilot_app:change-me-app@localhost:5433/paypilot?schema=public"

# Migration connection: paypilot_migrator owns the schema and is used only by
# Prisma CLI migrations and the controlled provisioning script.
DIRECT_URL="postgresql://paypilot_migrator:change-me-migrator@localhost:5433/paypilot?schema=public"

# ------------------------------------------------------------------------------
# Keycloak / OpenID Connect
# ------------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=paypilot
KEYCLOAK_CLIENT_ID=paypilot-web
KEYCLOAK_ISSUER=http://localhost:8080/realms/paypilot
KEYCLOAK_AUDIENCE=paypilot-api
# Optional override. Defaults to <KEYCLOAK_ISSUER>/protocol/openid-connect/certs.
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/paypilot/protocol/openid-connect/certs

# Development-only password used by the provisioning script when it creates a
# Keycloak user. Never used by the application at runtime.
KEYCLOAK_DEV_USER_PASSWORD=change-me-dev-user

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# In development, Vite proxies /api to localhost:4000.
VITE_API_URL=http://localhost:4000/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=paypilot
VITE_KEYCLOAK_CLIENT_ID=paypilot-web
