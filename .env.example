# ==============================================================================
# PayPilot HRMS & Payroll SaaS - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH YOUR ACTUAL CONFIGURATION VALUES.
# DO NOT COMMIT THE .env FILE OR ANY ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Used by Prisma Client for application queries.
# For Supabase in production/pooled setups, use the connection pooler URL (Transaction mode, typically port 6543)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paypilot_dev?schema=public"

# DIRECT_URL:
# Used by Prisma CLI for migrations and schema introspection (requires direct session mode, port 5432)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/paypilot_dev?schema=public"

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Note: In development, Vite dev server proxies /api requests to localhost:4000.
VITE_API_URL=http://localhost:4000/api
