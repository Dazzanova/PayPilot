      "id": 13,
      "type": "timeseries",
      "title": "DB probe duration",
      "datasource": { "type": "prometheus", "uid": "paypilot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "expr": "paypilot_db_probe_duration_seconds{job=\"paypilot-api\"}",
          "legendFormat": "duration"
