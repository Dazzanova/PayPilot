// ==============================================================================
// PayPilot HRMS & Payroll SaaS - Relational Database Schema
// PostgreSQL with native row-level security
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  REMOTE
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  UNPAID
  BEREAVEMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  CALCULATING
  CALCULATED
  APPROVED
  PAID
  VOID
}

enum PayslipStatus {
  DRAFT
  ISSUED
  PAID
}

enum DeductionRuleType {
  RATE
  FIXED
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
}

enum PayrollImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ValidationSeverity {
  ERROR
  WARNING
  INFO
}

// ------------------------------------------------------------------------------
// Multi-Tenant Core Models
// ------------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  users                          User[]
  departments                    Department[]
  employees                      Employee[]
  attendanceRecords              AttendanceRecord[]
  leaveRequests                  LeaveRequest[]
  payrollRuns                    PayrollRun[]
  payslips                       Payslip[]
  auditLogs                      AuditLog[]
  payrollImportBatches           PayrollImportBatch[]
  importedPayrollRecords         ImportedPayrollRecord[]
  validationFindings             ValidationFinding[]
  payrollDeductionRules          PayrollDeductionRule[]
  payslipLineItems               PayslipLineItem[]
  payrollStatutorySettings       PayrollStatutorySetting[]
  payrollTaxSlabSets             PayrollTaxSlabSet[]
  payrollTaxSlabs                PayrollTaxSlab[]
  payrollProfessionalTaxSlabSets PayrollProfessionalTaxSlabSet[]
  payrollProfessionalTaxSlabs    PayrollProfessionalTaxSlab[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  identityIssuer  String?   @map("identity_issuer")
  identitySubject String?   @map("identity_subject")
  email           String    @unique
  role            UserRole  @default(EMPLOYEE)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relationships
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee             Employee?
  reviewedLeaves       LeaveRequest[]       @relation("ReviewedLeaves")
  auditLogs            AuditLog[]           @relation("ActorAuditLogs")
  payrollImportBatches PayrollImportBatch[] @relation("CreatedPayrollImports")

  @@unique([identityIssuer, identitySubject])
  @@index([organizationId])
  @@map("users")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  departmentId   String?        @map("department_id")
  userId         String?        @unique @map("user_id")
  employeeNumber String         @map("employee_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  phone          String?
  jobTitle       String         @map("job_title")
  employmentType EmploymentType @default(FULL_TIME) @map("employment_type")
  status         EmployeeStatus @default(ACTIVE)
  joinedAt       DateTime       @map("joined_at") @db.Date
  baseSalary     Decimal        @map("base_salary") @db.Decimal(12, 2)
  state          String?        @db.VarChar(2)
  pfApplicable   Boolean        @default(true) @map("pf_applicable")
  esiApplicable  Boolean        @default(true) @map("esi_applicable")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relationships
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department           Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  payslips             Payslip[]
  payrollImportRecords ImportedPayrollRecord[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departmentId])
  @@map("employees")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  employeeId     String           @map("employee_id")
  workDate       DateTime         @map("work_date") @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInTime    DateTime?        @map("check_in_time")
  checkOutTime   DateTime?        @map("check_out_time")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([organizationId, workDate])
  @@map("attendance_records")
}

model LeaveRequest {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  employeeId     String      @map("employee_id")
  leaveType      LeaveType   @map("leave_type")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  totalDays      Decimal     @map("total_days") @db.Decimal(4, 1)
  reason         String
  status         LeaveStatus @default(PENDING)
  reviewedById   String?     @map("reviewed_by_id")
  reviewedAt     DateTime?   @map("reviewed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ReviewedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("leave_requests")
}

model PayrollRun {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  payDate         DateTime      @map("pay_date") @db.Date
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0.00) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0.00) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal       @default(0.00) @map("total_net") @db.Decimal(14, 2)
  processedById   String?       @map("processed_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  calculatedAt    DateTime?     @map("calculated_at")
  approvedAt      DateTime?     @map("approved_at")
  paidAt          DateTime?     @map("paid_at")
  voidedAt        DateTime?     @map("voided_at")
  voidReason      String?       @map("void_reason")

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
  @@map("payroll_runs")
}

model Payslip {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  payrollRunId    String            @map("payroll_run_id")
  employeeId      String            @map("employee_id")
  grossPay        Decimal           @map("gross_pay") @db.Decimal(12, 2)
  totalDeductions Decimal           @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal           @map("net_pay") @db.Decimal(12, 2)
  currency        String            @default("USD")
  status          PayslipStatus     @default(DRAFT)
  documentUrl     String?           @map("document_url")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  baseSalary      Decimal           @default(0) @map("base_salary") @db.Decimal(12, 2)
  workingDays     Decimal           @default(0) @map("working_days") @db.Decimal(5, 2)
  paidDays        Decimal           @default(0) @map("paid_days") @db.Decimal(5, 2)
  unpaidDays      Decimal           @default(0) @map("unpaid_days") @db.Decimal(5, 2)
  absentDays      Decimal           @default(0) @map("absent_days") @db.Decimal(5, 2)
  lineItems       PayslipLineItem[]

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([organizationId])
  @@index([employeeId])
  @@map("payslips")
}

model PayrollDeductionRule {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  name           String
  type           DeductionRuleType
  value          Decimal           @db.Decimal(12, 2)
  taxable        Boolean           @default(true)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems    PayslipLineItem[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("payroll_deduction_rules")
}

model PayrollStatutorySetting {
  id                     String   @id @default(uuid())
  organizationId         String   @map("organization_id")
  effectiveFrom          DateTime @map("effective_from") @db.Date
  standardDeductionCents Int      @map("standard_deduction_cents")
  rebateThresholdCents   Int      @map("rebate_threshold_cents")
  rebateMaxCents         Int      @map("rebate_max_cents")
  cessRateBps            Int      @map("cess_rate_bps")
  pfEmployeeRateBps      Int      @map("pf_employee_rate_bps")
  pfWageCeilingCents     Int      @map("pf_wage_ceiling_cents")
  esiEmployeeRateBps     Int      @map("esi_employee_rate_bps")
  esiGrossCeilingCents   Int      @map("esi_gross_ceiling_cents")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@map("payroll_statutory_settings")
}

model PayrollTaxSlabSet {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  effectiveFrom  DateTime @map("effective_from") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slabs        PayrollTaxSlab[]

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@map("payroll_tax_slab_sets")
}

model PayrollTaxSlab {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  setId          String   @map("set_id")
  lowerCents     Int      @map("lower_cents")
  upperCents     Int?     @map("upper_cents")
  rateBps        Int      @map("rate_bps")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  set          PayrollTaxSlabSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, lowerCents])
  @@index([organizationId, setId])
  @@map("payroll_tax_slabs")
}

model PayrollProfessionalTaxSlabSet {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  state          String   @db.VarChar(2)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slabs        PayrollProfessionalTaxSlab[]

  @@unique([organizationId, state, effectiveFrom])
  @@index([organizationId, state, effectiveFrom])
  @@map("payroll_professional_tax_slab_sets")
}

model PayrollProfessionalTaxSlab {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  setId               String   @map("set_id")
  lowerCents          Int      @map("lower_cents")
  upperCents          Int?     @map("upper_cents")
  amountCents         Int      @map("amount_cents")
  februaryAmountCents Int?     @map("february_amount_cents")
  createdAt           DateTime @default(now()) @map("created_at")

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  set          PayrollProfessionalTaxSlabSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, lowerCents])
  @@index([organizationId, setId])
  @@map("payroll_professional_tax_slabs")
}

model PayslipLineItem {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  payslipId      String          @map("payslip_id")
  kind           PayslipLineKind
  label          String
  amount         Decimal         @db.Decimal(12, 2)
  ruleId         String?         @map("rule_id")
  sortOrder      Int             @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslip      Payslip               @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  rule         PayrollDeductionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([organizationId, payslipId])
  @@map("payslip_line_items")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PayrollImportBatch {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  createdById      String?             @map("created_by_id")
  originalFilename String              @map("original_filename")
  storageKey       String?             @map("storage_key")
  fileHash         String              @map("file_hash")
  fileSizeBytes    Int                 @map("file_size_bytes")
  rulesetVersion   String              @map("ruleset_version")
  status           PayrollImportStatus @default(PROCESSING)
  rowCount         Int                 @default(0) @map("row_count")
  validRowCount    Int                 @default(0) @map("valid_row_count")
  invalidRowCount  Int                 @default(0) @map("invalid_row_count")
  errorCount       Int                 @default(0) @map("error_count")
  warningCount     Int                 @default(0) @map("warning_count")
  infoCount        Int                 @default(0) @map("info_count")
  currency         String?
  payPeriodStart   DateTime?           @map("pay_period_start") @db.Date
  payPeriodEnd     DateTime?           @map("pay_period_end") @db.Date
  retentionUntil   DateTime            @map("retention_until")
  filePurgedAt     DateTime?           @map("file_purged_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  completedAt      DateTime?           @map("completed_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation("CreatedPayrollImports", fields: [createdById], references: [id], onDelete: SetNull)
  records      ImportedPayrollRecord[]
  findings     ValidationFinding[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, fileHash])
  @@map("payroll_import_batches")
}

model ImportedPayrollRecord {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  batchId         String    @map("batch_id")
  employeeId      String?   @map("employee_id")
  employeeNumber  String    @map("employee_number")
  rowNumber       Int       @map("row_number")
  payPeriodStart  DateTime? @map("pay_period_start") @db.Date
  payPeriodEnd    DateTime? @map("pay_period_end") @db.Date
  currency        String?
  grossPay        Decimal?  @map("gross_pay") @db.Decimal(14, 2)
  totalDeductions Decimal?  @map("total_deductions") @db.Decimal(14, 2)
  netPay          Decimal?  @map("net_pay") @db.Decimal(14, 2)
  isValid         Boolean   @default(false) @map("is_valid")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        PayrollImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee     Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  findings     ValidationFinding[]

  @@index([organizationId, batchId])
  @@index([employeeId])
  @@map("imported_payroll_records")
}

model ValidationFinding {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  batchId        String             @map("batch_id")
  recordId       String?            @map("record_id")
  rowNumber      Int?               @map("row_number")
  field          String?
  ruleCode       String             @map("rule_code")
  severity       ValidationSeverity
  message        String
  expected       String?
  actual         String?
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        PayrollImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  record       ImportedPayrollRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([organizationId, batchId, severity])
  @@index([batchId, rowNumber])
  @@map("validation_findings")
}
